# Set these variables ONLY on your own Windows PC. Never commit API keys.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HF_TOKEN=
GEMINI_API_KEY=
# Optional override for metadata model, depending on account availability:
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional local output directory override:
# PODBOT_DATA_DIR=C:\\Users\\You\\Documents\\PODBot

# PODBot v4.0 paid image API providers. Set only those you actually use.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=
STABILITY_API_KEY=
# Gemini image generation uses the same GEMINI_API_KEY as optional SEO.
